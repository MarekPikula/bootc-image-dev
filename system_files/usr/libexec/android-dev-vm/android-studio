#!/usr/bin/bash
# Starts Android Studio (/usr/bin/android-studio links here). Once per profile,
# from the second start on, it turns on automatic plugin updates (PLAN.md,
# Studio plugins).
set -uo pipefail

studio=/usr/lib/android-studio

# Best effort: Studio starts whatever happens here, and a failure is tried
# again next time.
turn_on_plugin_updates() {
  local home config marker updates option='<option name="PLUGINS_AUTO_UPDATE" value="true" />'
  # Where Studio keeps the profile: its JVM takes the home from the account,
  # not from $HOME.
  home="$(getent passwd "$(id -u)" | cut -d: -f6)" || return
  config="${XDG_CONFIG_HOME:-$home/.config}/Google/$(jq -r .dataDirectoryName "$studio/product-info.json")" || return
  marker="$config/.android-dev-vm-plugin-updates"
  updates="$config/options/updates.xml"
  # Only in a profile Studio made itself: one that exists before Studio's first
  # start makes it skip its first-start setup, the SDK wizard included.
  [[ -d $config && ! -e $marker ]] || return 0
  # A running Studio would save its own settings over the edit.
  ! pgrep -u "$(id -u)" -f "^$studio/" >/dev/null || return 0
  if [[ ! -e $updates ]]; then
    mkdir -p "${updates%/*}" &&
      printf '<application>\n  <component name="UpdatesConfigurable">\n    %s\n  </component>\n</application>\n' \
        "$option" >"$updates" || return
  elif ! grep -q 'name="PLUGINS_AUTO_UPDATE"' "$updates"; then
    if grep -q '<component name="UpdatesConfigurable">' "$updates"; then
      sed -i "s|<component name=\"UpdatesConfigurable\">|&\n    $option|" "$updates" || return
    else
      sed -i "s|</application>|  <component name=\"UpdatesConfigurable\">\n    $option\n  </component>\n&|" "$updates" || return
    fi
  fi
  # Once: if dev turns it off later, that stays.
  touch "$marker"
}
turn_on_plugin_updates || echo "android-studio: couldn't turn on automatic plugin updates" >&2
exec "$studio/bin/studio" "$@"
