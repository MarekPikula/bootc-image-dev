#!/usr/bin/bash
# First boot (android-dev-firstboot.service): create the home directories, then
# ask on tty1 for the admin and dev passwords, before the display manager
# starts. No password is ever baked into the image.
#
# A password that's already set is left alone. That's how a headless boot skips
# the prompt: pass the passwd.hashed-password.<user> (or
# passwd.plaintext-password.<user>) system credential, which systemd-sysusers
# applies when it creates the account (see its drop-in).
#
# Lives in /usr/libexec so SELinux labels it bin_t: systemd then runs it
# unconfined, where it may run passwd. (Under /usr/lib it would be lib_t and
# run as init_t, which may not.)
set -euo pipefail

max_attempts=5
state_dir="${STATE_DIRECTORY:-/var/lib/android-dev-vm}"

log_error() {
  echo "$*" >&2
  echo "$*" | systemd-cat -t android-dev-firstboot -p err 2>/dev/null || true
}

# Ctrl+C must not abort halfway and leave a login screen nobody can use.
trap '' INT
on_exit() {
  local rc=$?
  ((rc == 0)) || log_error "Setting passwords failed (exit $rc). Reboot to try again."
}
trap on_exit EXIT

# A password is set only if the shadow field holds a hash. If shadow can't be
# read, getent fails and the account counts as unset, so we ask rather than
# skip.
has_password() {
  local field
  field="$(getent shadow "$1" | cut -d: -f2)" || return 1
  [[ $field == \$* ]]
}

# Asks for a password twice and sets it with `passwd --stdin`, so the PAM
# pwquality rules still apply. $2, if given, is a password this one must not
# equal. Sets $password on success.
ask_password() {
  local user=$1 other=${2:-} attempt again
  for ((attempt = 1; attempt <= max_attempts; attempt++)); do
    printf '\nNew password for %s: ' "$user"
    IFS= read -rs password || password=
    printf '\nRetype it: '
    IFS= read -rs again || again=
    echo
    if [[ -z $password ]]; then
      echo "The password can't be empty."
    elif [[ $password != "$again" ]]; then
      echo "The passwords don't match."
    elif [[ -n $other && $password == "$other" ]]; then
      echo "Use a different password from admin's."
    else
      # passwd --stdin exits 0 even when PAM rejects the password
      # (shadow-utils 4.19), so check shadow instead. Only accounts without a
      # password get here.
      printf '%s\n' "$password" | passwd --stdin "$user" >/dev/null || true
      has_password "$user" && return 0
    fi
  done
  log_error "No valid password for $user after $max_attempts attempts."
  return 1
}

needs_password=()
for user in admin dev; do
  # Copies /etc/skel, and leaves an existing home alone.
  mkhomedir_helper "$user" 0077
  if selinuxenabled 2>/dev/null; then
    restorecon -R "$(getent passwd "$user" | cut -d: -f6)"
  fi
  has_password "$user" || needs_password+=("$user")
done

if ((${#needs_password[@]})); then
  # Keep kernel and systemd status messages from drawing over the prompt. On
  # failure, systemd stops it with the rest of the unit's processes.
  systemd-mute-console &
  mute_pid=$!
  clear 2>/dev/null || true
  cat <<'EOF'
Android dev VM: first boot

Set a password for each account:
  admin  administration only: updates, rollback, settings. dev can't use it.
  dev    daily work and Claude Code.
The two passwords must differ. Never type admin's password in dev's session.
EOF
  admin_password=
  for user in "${needs_password[@]}"; do
    if [[ $user == dev ]]; then
      ask_password dev "$admin_password"
    else
      ask_password "$user"
      admin_password=$password
    fi
  done
  unset password admin_password
  kill "$mute_pid" 2>/dev/null || true
fi

touch "$state_dir/firstboot.done"
