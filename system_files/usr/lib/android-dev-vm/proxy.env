# dev's proxy settings: Squid on loopback, the only way out (see
# nftables/dev-egress.nft). Read by the systemd --user environment generator
# (60-dev-proxy) and by /etc/profile.d/dev-proxy.sh, only for dev. Both parse
# it as KEY=VALUE lines, so keep it to plain assignments.
http_proxy=http://127.0.0.1:3128
https_proxy=http://127.0.0.1:3128
no_proxy=localhost,127.0.0.1,::1
HTTP_PROXY=http://127.0.0.1:3128
HTTPS_PROXY=http://127.0.0.1:3128
NO_PROXY=localhost,127.0.0.1,::1
# Java ignores the variables above (Gradle, sdkmanager, Android Studio's JBR).
JAVA_TOOL_OPTIONS="-Dhttp.proxyHost=127.0.0.1 -Dhttp.proxyPort=3128 -Dhttps.proxyHost=127.0.0.1 -Dhttps.proxyPort=3128 -Dhttp.nonProxyHosts=localhost|127.0.0.1|[::1]"
