# Pinned inputs for the image build, passed to the build as
#   podman build --build-arg-file versions.env ...
# One ARG=value per line; comments and blank lines are ignored.

# Fedora Kinoite 44, multi-arch index digest. Not signed upstream, so the digest
# is our only pin. Resolve a new one with:
#   skopeo inspect --format '{{.Digest}}' docker://quay.io/fedora/fedora-kinoite:44
BASE_IMAGE=quay.io/fedora/fedora-kinoite:44@sha256:6603ff7db37b4dfa7f23799d986491857863d2f6a6df037cfad84a759c666ec8
