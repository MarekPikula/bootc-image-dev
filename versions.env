# Pinned inputs for the image build, passed to the build as
#   podman build --build-arg-file versions.env ...
# One ARG=value per line; comments and blank lines are ignored.

# Fedora Kinoite 44, the rolling tag. It can't be pinned by digest: Fedora
# deletes superseded manifests from this repo within days. buildah records the
# digest each build used in the image's org.opencontainers.image.base.*
# annotations. Locally, `podman build --pull=newer` picks up a newer base.
BASE_IMAGE=quay.io/fedora/fedora-kinoite:44

# Android Studio: the Linux .tar.gz and its SHA-256 from
# https://developer.android.com/studio. dl.google.com serves the same file as
# the page's link.
ANDROID_STUDIO_URL=https://dl.google.com/android/studio/ide-zips/2026.2.1.8/android-studio-rabbit1-linux.tar.gz
ANDROID_STUDIO_SHA256=f8775c67cf899d9133712a2d7ee3ef7231e07fb16dbe0544c47e5f5babd5931b

# Claude Code: Anthropic's dnf repo (the stable channel, see PLAN.md) and the
# fingerprint of its signing key, build_files/claude-code.asc, both from
# https://code.claude.com/docs/en/setup. The version isn't pinned: each build
# installs the channel's current release, signed with that key.
CLAUDE_CODE_REPO=https://downloads.claude.ai/claude-code/rpm/stable
CLAUDE_CODE_KEY_FINGERPRINT=31DDDE24DDFAB679F42D7BD2BAA929FF1A7ECACE
